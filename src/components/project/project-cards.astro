---
import { getCollection } from "astro:content";
import { SITE } from "@/consts";
import ContentCard from "@/components/ui/ContentCard.astro";
import { resolveSlugParam } from "@/lib/utils";

type Props = {
    obeyCount?: boolean;
};

const { obeyCount = false } = Astro.props;

const allProjects = await getCollection("project", ({ data }) => !data.draft);
const renderProjects = obeyCount ? allProjects.slice(0, SITE.NUM_WORKS_ON_HOMEPAGE) : allProjects;
---

<div class="projects-container" id="projects-container">
    <h3 class="mb-4">Projects</h3>
    <div class="flex flex-col gap-2">
        {
            renderProjects.map((post: any) => {
                const rawSlug = post.data?.slug || post.slug || post.id;
                const slugParam = resolveSlugParam(rawSlug, "projects");
                return (
                    <ContentCard
                        title={post.data.title}
                        description={post.data.description}
                        date={new Date(post.data.date)}
                        url={`/projects/${slugParam}`}
                        tags={post.data.tags || []}
                    />
                );
            })
        }
    </div>
</div>
