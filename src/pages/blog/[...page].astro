---
import Layout from "@/layouts/Layout.astro";
import { BLOG, SITE } from "@/consts";
import BlogCards from "@/components/blog/blog-cards.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths({ paginate }: any) {
    const allPosts = await getCollection("blog");
    const posts = allPosts
        .filter((item) => item.data?.draft !== true)
        .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

    return paginate(posts, { pageSize: SITE.PAGE_SIZE });
}

const { page } = Astro.props;
const currentPageId = page.data?.[page.currentPage]?.data?.id;
const pageDataEntry = await getEntry("pageData", currentPageId);
const pageDataLink = await getEntry("links", currentPageId);
const metadata = pageDataEntry?.data;
---

<Layout title={`${BLOG.TITLE} - Page ${page.currentPage}`} description={BLOG.DESCRIPTION}>
    <BlogCards page={page} />

    <nav>
        {page.url.prev && <a href={page.url.prev}>← Previous</a>}
        <span>Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next && <a href={page.url.next}>Next →</a>}
    </nav>
</Layout>
