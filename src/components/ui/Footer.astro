---
---
<div class="flex justify-between items-center mt-10">
    <span>
        Lakshmanshankar © {new Date().getFullYear()}
        <!-- <a href="https://choosealicense.com/licenses/mit/">MIT License</a> -->
    </span>

    <div class="flex items-center gap-3">
        <button
            id="reduce-animations-button"
            type="button"
            aria-label="Reduce animations"
            title="Reduce animations"
            class="theme-toggle group cursor-pointer"
        >
            <svg
                data-motion-icon="enabled"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
            >
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <svg
                data-motion-icon="disabled"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hidden group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
            >
                <polyline points="12.41 6.75 13 2 10.57 4.92"></polyline>
                <polyline points="18.57 12.91 21 10 15.66 10"></polyline>
                <polyline points="8 8 3 14 12 14 11 22 16 16"></polyline>
                <line x1="2" y1="2" x2="22" y2="22"></line>
            </svg>
        </button>
        <span class="w-px h-3.5 bg-stone-300 dark:bg-neutral-800" aria-hidden="true"></span>
        <button id="light-theme-button" aria-label="Light theme toggle" class="theme-toggle group cursor-pointer">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
            >
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
        </button>
        <button id="dark-theme-button" aria-label="Dark theme toggle" class="theme-toggle group cursor-pointer">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
            >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
        </button>
        <button id="system-theme-button" aria-label="System theme" class="theme-toggle group cursor-pointer">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
            >
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
        </button>
    </div>
</div>

<script>
    import { setupReduceAnimationsButton } from "@/lib/animations";

    document.addEventListener("astro:page-load", setupReduceAnimationsButton);
    document.addEventListener("DOMContentLoaded", setupReduceAnimationsButton);
    setupReduceAnimationsButton();
</script>
