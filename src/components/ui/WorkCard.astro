---
import ArrowIcon from "@/components/ui/ArrowIcon.astro";

interface Props {
    title: string;
    description: string;
    date: string;
    endDate: string;
    role: string;
    url: string;
    showArrow?: boolean;
}

const { title, description, date, url, endDate, role, showArrow = true } = Astro.props;
---

<a
    href={url}
    class="post-item block my-0 py-5 no-underline hover:transition-all muted-hover relative group px-4 md:px-5 rounded-xl border border-transparent hover:border-stone-200 dark:hover:border-neutral-800"
>
    <div class="flex flex-col h-full">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h4 class="my-0 text-lg md:text-xl font-bold text-stone-900 dark:text-stone-100 group-hover:text-[var(--brand-color)] transition-colors duration-200">
                    {title}
                </h4>
                <div class="flex items-center gap-2 mt-1 mb-3 text-sm font-medium text-stone-500 dark:text-neutral-400">
                    <span>{role}</span>
                    <span class="text-stone-300 dark:text-neutral-600">•</span>
                    <span>{date} - {endDate}</span>
                </div>
            </div>
            {showArrow && <ArrowIcon class="mt-1 text-stone-400 group-hover:text-[var(--brand-color)] transition-all duration-300 group-hover:translate-x-1 hidden md:block" />}
        </div>
        
        <p class="mt-0! mb-2 text-stone-600 dark:text-neutral-300 leading-relaxed line-clamp-2 md:line-clamp-3">
            {description}
        </p>
    </div>
</a>
