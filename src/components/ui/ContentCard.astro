---
import FormattedDate from "@/components/ui/FormattedDate.astro";
import ArrowIcon from "@/components/ui/ArrowIcon.astro";

interface Props {
    title: string;
    description: string;
    date: Date;
    url: string;
    tags?: string[];
    showArrow?: boolean;
}

const { title, description, date, url, tags = [], showArrow = true } = Astro.props;
---

<a
    href={url}
    class="post-item block my-0 py-5 no-underline hover:transition-all muted-hover relative group px-4 md:px-5 rounded-xl"
    data-filter-tags={tags.join(",")}
>
    <div class="flex flex-col h-full">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h4 class="my-0 text-lg md:text-xl font-bold text-stone-900 dark:text-stone-100 group-hover:text-[var(--brand-color)] transition-colors duration-200">
                    {title}
                </h4>
                <div class="flex items-center gap-2 mt-1 mb-3 text-sm font-medium text-stone-500 dark:text-neutral-400">
                    <FormattedDate date={date} includeYear />
                </div>
            </div>
            {showArrow && <ArrowIcon class="mt-1 text-stone-400 group-hover:text-[var(--brand-color)] transition-all duration-300 group-hover:translate-x-1 hidden md:block" />}
        </div>
        
        <p class="mb-4 mt-0! text-stone-600 dark:text-neutral-300 leading-relaxed line-clamp-2 md:line-clamp-3">
            {description}
        </p>
        
        {
            tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-auto">
                    {tags.map((tag) => (
                        <span class="bg-stone-100 dark:bg-neutral-800/80 text-stone-700 dark:text-neutral-300 text-xs font-medium px-2.5 py-1 rounded-md border border-stone-200/50 dark:border-neutral-700/50 transition-colors group-hover:border-stone-300 dark:group-hover:border-neutral-600">
                            {tag}
                        </span>
                    ))}
                </div>
            )
        }
    </div>
</a>
