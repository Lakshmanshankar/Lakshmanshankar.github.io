---
import { getCollection } from "astro:content";
import TagFilter from "@/components/blog/TagFilter.astro";
import BlogPostCard from "@/components/blog/BlogPostCard.astro";

interface Props {
    activeTag?: string;
    page: any;
}

const { activeTag = "all", page } = Astro.props;

// We still need allTags for the filter component
const allPosts = await getCollection("blog");
const posts = allPosts.filter((item) => item.data?.draft !== true);
const sortedPosts = posts.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const allTags = Array.from(new Set(sortedPosts.flatMap((post) => post.data.tags ?? [])));

const displayedPosts = page ? page.data : [];
const baseUrl = activeTag === "all" ? "/blog" : `/tags/${activeTag}`;
---

<div class="min-h-[81vh] flex flex-col">
    <p class="mb-2 text-stone-700 dark:text-neutral-300">
        I write blogs about the interesting things I've stumbled upon. The domain is changing
        because my work is evolving. It started as frontend and React, but now I am working with
        semantic data layers. My blog reflects this evolution.
    </p>
    <div class="flex flex-col flex-1">
        <div class="list-none pl-0 flex flex-col flex-1">
            <TagFilter tags={allTags as string[]} activeTag={activeTag} />
            <ul id="posts-container" class="list-none m-0 p-0! flex flex-col gap-0 mt-6">
                {displayedPosts.map((post: any) => <BlogPostCard post={post} />)}
            </ul>

            {
                page && page.lastPage > 1 && (
                    <div class="flex gap-2 justify-center mt-auto pt-10">
                        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => {
                            const href = pageNum === 1 ? baseUrl : `${baseUrl}/${pageNum}`;
                            const isActive = pageNum === page.currentPage;
                            return (
                                <a
                                    href={href}
                                    class={`px-3 py-1 border rounded-md no-underline ${
                                        isActive
                                            ? "bg-stone-200 dark:bg-neutral-800 text-stone-900 dark:text-neutral-100 border-stone-300 dark:border-neutral-700 font-medium"
                                            : "hover:bg-stone-100 dark:hover:bg-neutral-900 border-transparent"
                                    }`}
                                >
                                    {pageNum}
                                </a>
                            );
                        })}
                    </div>
                )
            }
        </div>
    </div>
</div>
